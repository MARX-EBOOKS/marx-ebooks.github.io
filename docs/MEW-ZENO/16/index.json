rx  Lohn, Preis, Profit", "headings": [{"tag": "title", "text": "Karl Marx  – Lohn, Preis, Profit", "level": 1, "id": "h8-1", "source_file": "ME16-101.html", "chapter_number": 8, "filename": "ME16-101.html"}, {"tag": "h5", "text": "[Einleitendes]", "level": 5, "id": "h8-2", "source_file": "ME16-101.html", "chapter_number": 8, "filename": "ME16-101.html"}, {"tag": "h5", "text": "1. [Produktion und Löhne]", "level": 5, "id": "h8-3", "source_file": "ME16-101.html", "chapter_number": 8, "filename": "ME16-101.html"}, {"tag": "h5", "text": "2. [Produktion, Lohn, Profit]", "level": 5, "id": "h8-4", "source_file": "ME16-101.html", "chapter_number": 8, "filename": "ME16-101.html"}, {"tag": "h5", "text": "3. [Löhne und Geldumlauf]", "level": 5, "id": "h8-5", "source_file": "ME16-101.html", "chapter_number": 8, "filename": "ME16-101.html"}, {"tag": "h5", "text": "4. [Angebot und Nachfrage]", "level": 5, "id": "h8-6", "source_file": "ME16-101.html", "chapter_number": 8, "filename": "ME16-101.html"}, {"tag": "h5", "text": "5. [Löhne und Preise]", "level": 5, "id": "h8-7", "source_file": "ME16-101.html", "chapter_number": 8, "filename": "ME16-101.html"}, {"tag": "h5", "text": "6. [Wert und Arbeit]", "level": 5, "id": "h8-8", "source_file": "ME16-101.html", "chapter_number": 8, "filename": "ME16-101.html"}, {"tag": "h5", "text": "7. Die Arbeitskraft", "level": 5, "id": "h8-9", "source_file": "ME16-101.html", "chapter_number": 8, "filename": "ME16-101.html"}, {"tag": "h5", "text": "8. Die Produktion des Mehrwerts", "level": 5, "id": "h8-10", "source_file": "ME16-101.html", "chapter_number": 8, "filename": "ME16-101.html"}, {"tag": "h5", "text": "9. Der Wert der Arbeit", "level": 5, "id": "h8-11", "source_file": "ME16-101.html", "chapter_number": 8, "filename": "ME16-101.html"}, {"tag": "h5", "text": "10. Profit wird gemacht durch Verlauf einer Ware zu ihrem Wert", "level": 5, "id": "h8-12", "source_file": "ME16-101.html", "chapter_number": 8, "filename": "ME16-101.html"}, {"tag": "